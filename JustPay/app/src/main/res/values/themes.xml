<resources>

    <style name="Base.Theme.JustPay.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="jpBg">#000000</item>
        <item name="jpS1">#121212</item>
        <item name="jpS2">#1C1C1E</item>
        <item name="jpLine">#12FFFFFF</item>
        <item name="jpTx">#F8FAFC</item>
        <item name="jpTx2">#94A3B8</item>
        <item name="jpTx3">#6F7B8F</item>
        <item name="jpIconDim">#6E7686</item>
        <item name="jpThumb">#FFFFFF</item>
        <item name="jpAcFill">#8B9BFF</item>
        <item name="jpAcTextDark">#8B9BFF</item>
        <item name="jpAcTextLight">#4A55A8</item>
        <item name="jpAc">?attr/jpAcFill</item>
        <item name="jpAct">?attr/jpAcTextDark</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorHint">#6F7B8F</item>
        <item name="android:colorAccent">?attr/jpAcFill</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Base.Theme.JustPay.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="jpBg">#F2F2EF</item>
        <item name="jpS1">#FFFFFF</item>
        <item name="jpS2">#E7E7E3</item>
        <item name="jpLine">#14111216</item>
        <item name="jpTx">#111216</item>
        <item name="jpTx2">#9E111216</item>
        <item name="jpTx3">#6B111216</item>
        <item name="jpIconDim">#939494</item>
        <item name="jpThumb">#0D0E11</item>
        <item name="jpAcFill">#8B9BFF</item>
        <item name="jpAcTextDark">#8B9BFF</item>
        <item name="jpAcTextLight">#4A55A8</item>
        <item name="jpAc">?attr/jpAcFill</item>
        <item name="jpAct">?attr/jpAcTextLight</item>
        <item name="android:windowBackground">#F2F2EF</item>
        <item name="android:textColorPrimary">#111216</item>
        <item name="android:textColorHint">#6B111216</item>
        <item name="android:colorAccent">?attr/jpAcTextLight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Цвета акцента, накладываются на тему -->
    <style name="Jp.Accent.Lavender" parent="">
        <item name="jpAcFill">#8B9BFF</item>
        <item name="jpAcTextDark">#8B9BFF</item>
        <item name="jpAcTextLight">#4A55A8</item>
    </style>
    <style name="Jp.Accent.Violet" parent="">
        <item name="jpAcFill">#CDBDFF</item>
        <item name="jpAcTextDark">#CDBDFF</item>
        <item name="jpAcTextLight">#63568F</item>
    </style>
    <style name="Jp.Accent.Sky" parent="">
        <item name="jpAcFill">#98CCF9</item>
        <item name="jpAcTextDark">#98CCF9</item>
        <item name="jpAcTextLight">#2A638A</item>
    </style>
    <style name="Jp.Accent.Mint" parent="">
        <item name="jpAcFill">#8DD5B2</item>
        <item name="jpAcTextDark">#8DD5B2</item>
        <item name="jpAcTextLight">#206A4E</item>
    </style>
    <style name="Jp.Accent.Lime" parent="">
        <item name="jpAcFill">#B9CF83</item>
        <item name="jpAcTextDark">#B9CF83</item>
        <item name="jpAcTextLight">#536525</item>
    </style>
    <style name="Jp.Accent.Amber" parent="">
        <item name="jpAcFill">#F9BB72</item>
        <item name="jpAcTextDark">#F9BB72</item>
        <item name="jpAcTextLight">#835414</item>
    </style>
    <style name="Jp.Accent.Rose" parent="">
        <item name="jpAcFill">#FEB0D2</item>
        <item name="jpAcTextDark">#FEB0D2</item>
        <item name="jpAcTextLight">#894A68</item>
    </style>

    <!-- Итоговые темы, на новых Android дополняются в values-v27 и v29 -->
    <style name="Theme.JustPay.Dark" parent="Base.Theme.JustPay.Dark" />
    <style name="Theme.JustPay.Light" parent="Base.Theme.JustPay.Light" />

    <!-- Базовый текст -->
    <style name="Jp.Text" parent="">
        <item name="android:textColor">?attr/jpTx</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/plex_regular</item>
    </style>
    <style name="Jp.Semi" parent="Jp.Text">
        <item name="android:fontFamily">@font/plex_semibold</item>
    </style>
    <style name="Jp.Bold" parent="Jp.Text">
        <item name="android:fontFamily">@font/plex_bold</item>
    </style>
    <!-- Шрифт цифр и заголовков (Unbounded) -->
    <style name="Jp.Disp" parent="Jp.Text">
        <item name="android:fontFamily">@font/exo_bold</item>
    </style>
    <style name="Jp.Label" parent="Jp.Semi">
        <item name="android:textColor">?attr/jpTx2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Jp.Caption" parent="Jp.Text">
        <item name="android:textColor">?attr/jpTx3</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="Jp.Section" parent="Jp.Semi">
        <item name="android:textColor">?attr/jpTx2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="Jp.ScreenTitle" parent="Jp.Disp">
        <item name="android:textSize">24sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
    </style>
    <style name="Jp.Card" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/d_card</item>
    </style>
    <style name="Jp.Card.Divided" parent="Jp.Card">
        <item name="android:divider">@drawable/d_divider</item>
        <item name="android:showDividers">middle</item>
    </style>
    <style name="Jp.Row" parent="">
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/d_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Jp.DividerLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/jpLine</item>
    </style>

    <!-- Кнопки -->
    <style name="Jp.Btn" parent="Jp.Bold">
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="Jp.Btn.Primary">
        <item name="android:background">@drawable/d_btn_primary</item>
        <item name="android:textColor">@color/jp_ink</item>
    </style>
    <style name="Jp.Btn.Secondary">
        <item name="android:background">@drawable/d_btn_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">54dp</item>
    </style>
    <style name="Jp.Btn.Outline">
        <item name="android:background">@drawable/d_btn_outline</item>
    </style>
    <style name="Jp.Btn.Text" parent="Jp.Semi">
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">?attr/jpTx2</item>
    </style>
    <style name="Jp.CircleBtn" parent="Jp.Text">
        <item name="android:background">@drawable/d_circle_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Jp.Seg" parent="Jp.Semi">
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:background">@drawable/d_seg_item</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Jp.Chip" parent="Jp.Semi">
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/seg_text_chip</item>
        <item name="android:background">@drawable/d_chip</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Jp.Input" parent="Jp.Text">
        <item name="android:background">@drawable/d_input</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Jp.FieldError" parent="Jp.Semi">
        <item name="android:textColor">@color/jp_err</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Jp.SheetAnim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>
    <!-- Флажок согласия -->
    <style name="Jp.Check" parent="">
        <item name="android:button">@drawable/d_check</item>
        <item name="android:fontFamily">@font/plex_regular</item>
        <item name="android:textColor">?attr/jpTx2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>
