<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Верхняя строка: логотип и уведомления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Jp.Disp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="-0.01"
                android:text="JustPay"
                android:textSize="17sp" />

            <FrameLayout
                android:id="@+id/btn_bell"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/d_circle_btn"
                android:clickable="true"
                android:contentDescription="Уведомления"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell" />

                <View
                    android:id="@+id/bell_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/d_dot"
                    android:backgroundTint="@color/jp_ac"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Общая сумма -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Расходы на подписки в месяц" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/total_num"
                    style="@style/Jp.Disp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:text="0"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/total_cur"
                    style="@style/Jp.Disp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="₽"
                    android:textColor="?attr/jpTx3"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/total_meta"
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/manrope_regular" />

            <LinearLayout
                android:id="@+id/saved_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/d_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:visibility="gone">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/d_dot"
                    android:backgroundTint="@color/jp_ac" />

                <TextView
                    android:id="@+id/saved_text"
                    style="@style/Jp.Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ближайшее списание -->
        <LinearLayout
            android:id="@+id/next_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_next_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/next_tag"
                    style="@style/Jp.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.72"
                    android:letterSpacing="0.04"
                    android:textColor="@color/jp_ink"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/next_name"
                    style="@style/Jp.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/jp_ink"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/next_sub"
                    style="@style/Jp.Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:textColor="@color/jp_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/next_price"
                style="@style/Jp.Disp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:textColor="@color/jp_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Поиск -->
        <EditText
            android:id="@+id/search"
            style="@style/Jp.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:hint="Поиск по названию"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="40"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <!-- Фильтр по статусу -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/d_seg_bar"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/seg_all"
                style="@style/Jp.Seg"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/seg_active"
                style="@style/Jp.Seg"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/seg_paused"
                style="@style/Jp.Seg"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Список подписок -->
        <LinearLayout
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/list_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/list_empty"
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:paddingStart="20dp"
                android:paddingTop="32dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp"
                android:textColor="?attr/jpTx2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="96dp" />
    </LinearLayout>
</ScrollView>
