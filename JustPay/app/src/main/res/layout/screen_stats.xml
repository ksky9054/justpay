<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Jp.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Аналитика" />

        <!-- Годовая сумма -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp">

            <TextView
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="В год на подписки уходит" />

            <TextView
                android:id="@+id/st_year"
                style="@style/Jp.Disp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/st_sub"
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope_regular" />
        </LinearLayout>

        <!-- Серия использования по всем подпискам -->
        <LinearLayout
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/st_star"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/st_streak"
                            style="@style/Jp.Disp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.02"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/st_streak_label"
                            style="@style/Jp.Semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="?attr/jpTx2"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/st_best"
                        style="@style/Jp.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/st_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/Jp.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.15"
                android:text="Звезда за день, когда вы пользовались хотя бы одной подпиской. Отмечать использование можно в карточке подписки." />
        </LinearLayout>

        <!-- Неиспользуемые подписки -->
        <LinearLayout
            android:id="@+id/st_unused_card"
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:paddingTop="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Jp.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Без активности больше двух недель"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/st_unused_sub"
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="?attr/jpTx2"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/st_unused_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Категории -->
        <LinearLayout
            android:id="@+id/st_cats_card"
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/st_bar"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/st_cat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/st_cats_empty"
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text="Нет активных подписок"
                android:textColor="?attr/jpTx2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Подсказка / инсайт -->
        <TextView
            android:id="@+id/st_insight"
            style="@style/Jp.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card_s2"
            android:lineSpacingMultiplier="1.15"
            android:padding="18dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Самые дорогие -->
        <TextView
            style="@style/Jp.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="Самые дорогие"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/st_top"
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical" />

        <!-- Экономия на паузах -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_dashed_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Jp.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Экономия на паузах"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/st_paused_n"
                    style="@style/Jp.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="?attr/jpTx2"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/st_saved"
                style="@style/Jp.Disp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                android:textColor="?attr/jpAct"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />
    </LinearLayout>
</ScrollView>
