<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Jp.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Профиль" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ru.eridian.justpay.ui.AvatarView
                android:id="@+id/pf_avatar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:clickable="true"
                android:contentDescription="Сменить аватар"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pf_name"
                    style="@style/Jp.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/pf_email"
                    style="@style/Jp.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="?attr/jpTx2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pf_avatar_edit"
                    style="@style/Jp.Semi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Сменить аватар"
                    android:textColor="?attr/jpAct"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Jp.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оформление" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Jp.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Тема"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/d_seg_bar_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/theme_dark"
                    style="@style/Jp.Seg"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/d_seg_item_s1"
                    android:text="Тёмная"
                    android:textColor="@color/seg_text_s1" />

                <TextView
                    android:id="@+id/theme_light"
                    style="@style/Jp.Seg"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/d_seg_item_s1"
                    android:text="Светлая"
                    android:textColor="@color/seg_text_s1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Jp.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Напоминания" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/remind_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jp.Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Предупреждать о списаниях"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Jp.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Уведомление в 09:00, если для подписки не задана своя дата"
                        android:textColor="?attr/jpTx2"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/remind_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:showText="false"
                    android:thumb="@drawable/sw_thumb"
                    android:track="@drawable/sw_track" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/remind_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/day_1"
                    style="@style/Jp.Seg"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/d_chip_day"
                    android:text="За 1 день"
                    android:textColor="@color/seg_text_s1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/day_3"
                    style="@style/Jp.Seg"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/d_chip_day"
                    android:text="За 3 дня"
                    android:textColor="@color/seg_text_s1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/day_7"
                    style="@style/Jp.Seg"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/d_chip_day"
                    android:text="За 7 дней"
                    android:textColor="@color/seg_text_s1"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/day_custom"
                style="@style/Jp.Seg"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/d_chip_day"
                android:contentDescription="Выбрать свой срок напоминания"
                android:textColor="@color/seg_text_s1"
                android:textSize="13sp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:id="@+id/streak_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jp.Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Серия под угрозой"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Jp.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Вечером в 20:00, если сегодня ещё нет отметки, а серию можно потерять"
                        android:textColor="?attr/jpTx2"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/streak_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:showText="false"
                    android:thumb="@drawable/sw_thumb"
                    android:track="@drawable/sw_track" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:id="@+id/idle_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jp.Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Подписки без активности"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Jp.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Не чаще раза в неделю, в 12:00: чем не пользуетесь больше двух недель"
                        android:textColor="?attr/jpTx2"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/idle_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:showText="false"
                    android:thumb="@drawable/sw_thumb"
                    android:track="@drawable/sw_track" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Jp.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Активность в приложениях" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/usage_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jp.Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Доступ к статистике телефона"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/usage_status"
                        style="@style/Jp.Semi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <TextView
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:padding="16dp"
                android:text="Нужен, чтобы считать, сколько раз вы открывали приложения своих сервисов. JustPay читает данные только тех приложений, которые вы сами привязали к подписке, и хранит их на телефоне. Без доступа можно отмечать использование вручную."
                android:textColor="?attr/jpTx2"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/Jp.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оплата" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/currency_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView style="@style/Jp.Semi" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Валюта" android:textSize="15sp" />
                <TextView android:id="@+id/pf_currency" style="@style/Jp.Text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="?attr/jpTx2" android:textSize="15sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pf_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/pf_cards_empty"
                style="@style/Jp.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:text="Способы оплаты появятся здесь, когда вы укажете их в подписках. Номера карт вводить не нужно." />
        </LinearLayout>

        <TextView
            style="@style/Jp.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="О приложении" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Jp.Semi" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Как считаются расходы" android:textSize="15sp" />
                <TextView style="@style/Jp.Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.15"
                    android:text="В сумму входят только активные подписки. Годовая цена делится на 12, недельная умножается на 52 и делится на 12. Приостановленные подписки считаются экономией."
                    android:textColor="?attr/jpTx2" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Jp.Semi" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Серия использования" android:textSize="15sp" />
                <TextView style="@style/Jp.Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.15"
                    android:text="Звезда за каждый день, когда вы пользовались подпиской: данные приложения или ручная отметка. Серия — это дни подряд. Если сегодня отметки ещё нет, серия не прерывается до конца дня."
                    android:textColor="?attr/jpTx2" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Jp.Semi" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ваши данные" android:textSize="15sp" />
                <TextView style="@style/Jp.Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.15"
                    android:text="Аккаунт, подписки и статистика хранятся только на устройстве. JustPay не списывает деньги и не подключается к банкам: он лишь показывает, что и когда спишут сервисы."
                    android:textColor="?attr/jpTx2" android:textSize="13sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:id="@+id/row_onboarding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView style="@style/Jp.Semi" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Показать знакомство заново" android:textSize="15sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Jp.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Аккаунт" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_logout"
                style="@style/Jp.Semi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:text="Выйти из аккаунта"
                android:textSize="15sp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <TextView
                android:id="@+id/row_delete"
                style="@style/Jp.Semi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:text="Удалить аккаунт и все данные"
                android:textColor="@color/jp_err"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_eridian" />

            <TextView
                style="@style/Jp.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.42"
                android:text="ЭРИДИАН"
                android:textColor="?attr/jpTx2"
                android:textSize="12sp" />

            <TextView
                style="@style/Jp.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="JustPay 1.0 · продукт компании «Эридиан»" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
