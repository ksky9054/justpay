<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Jp.ScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Календарь" />

        <!-- Навигация по месяцам -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/cal_title"
                style="@style/Jp.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/cal_prev"
                style="@style/Jp.CircleBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Предыдущий месяц"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_left" />

            <ImageView
                android:id="@+id/cal_next"
                style="@style/Jp.CircleBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:contentDescription="Следующий месяц"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_right_tx" />
        </LinearLayout>

        <!-- Сумма за месяц и остаток -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                style="@style/Jp.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="16dp">

                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="За месяц"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/cal_sum"
                    style="@style/Jp.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Jp.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:padding="16dp">

                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ещё предстоит"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/cal_left"
                    style="@style/Jp.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:textColor="?attr/jpAct"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Сетка календаря -->
        <LinearLayout
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:paddingStart="10dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/cal_weekdays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal" />

            <GridLayout
                android:id="@+id/cal_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7" />
        </LinearLayout>

        <!-- Список списаний за выбранный день -->
        <TextView
            android:id="@+id/cal_sel_title"
            style="@style/Jp.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:textSize="15sp" />

        <LinearLayout
            style="@style/Jp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/cal_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/cal_empty"
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="В этот день списаний нет"
                android:textColor="?attr/jpTx2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />
    </LinearLayout>
</ScrollView>
