<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/jpBg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
                android:id="@+id/btn_close"
                style="@style/Jp.CircleBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Закрыть"
                android:scaleType="center"
                android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/title"
            style="@style/Jp.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Новая подписка"
            android:textSize="17sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quick_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:text="Популярные" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/quick_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="22dp"
                android:paddingEnd="16dp">

                <!-- Название -->
                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:text="Название" />

                <EditText
                    android:id="@+id/f_name"
                    style="@style/Jp.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Например, Кинопоиск"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="40" />

                <TextView
                    android:id="@+id/err_name"
                    style="@style/Jp.FieldError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Стоимость -->
                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:paddingStart="4dp"
                    android:id="@+id/label_price"
                    android:text="Стоимость" />

                <EditText
                    android:id="@+id/f_price"
                    style="@style/Jp.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/unbounded_medium"
                    android:hint="0"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLength="10"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/err_price"
                    style="@style/Jp.FieldError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Период -->
                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:paddingStart="4dp"
                    android:text="Период" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/d_seg_bar"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/cyc_w"
                        style="@style/Jp.Seg"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="Неделя" />

                    <TextView
                        android:id="@+id/cyc_m"
                        style="@style/Jp.Seg"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Месяц" />

                    <TextView
                        android:id="@+id/cyc_y"
                        style="@style/Jp.Seg"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Год" />
                </LinearLayout>

                <!-- Дата -->
                <LinearLayout
                    android:id="@+id/date_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jp.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:paddingStart="4dp"
                        android:text="Следующее списание" />

                    <TextView
                        android:id="@+id/f_date"
                        style="@style/Jp.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:contentDescription="Выбрать дату следующего списания"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/err_date"
                        style="@style/Jp.FieldError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Напоминание о платеже -->
                <LinearLayout
                    android:id="@+id/remind_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jp.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:paddingStart="4dp"
                        android:text="Напомнить об оплате" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/d_seg_bar"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/rem_default"
                            style="@style/Jp.Seg"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1.3"
                            android:text="Как в профиле"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/rem_custom"
                            style="@style/Jp.Seg"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1.2"
                            android:text="Своя дата"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/rem_off"
                            style="@style/Jp.Seg"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="0.8"
                            android:text="Выкл"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/f_remind"
                        style="@style/Jp.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:contentDescription="Выбрать дату напоминания"
                        android:focusable="true"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/err_remind"
                        style="@style/Jp.FieldError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/remind_hint"
                        style="@style/Jp.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:paddingStart="4dp" />
                </LinearLayout>

                <!-- Категория -->
                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:paddingStart="4dp"
                    android:text="Категория" />

                <ru.eridian.justpay.ui.FlowLayout
                    android:id="@+id/cat_flow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- Способ оплаты -->
                <TextView
                    style="@style/Jp.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:paddingStart="4dp"
                    android:text="Способ оплаты, необязательно" />

                <EditText
                    android:id="@+id/f_card"
                    style="@style/Jp.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Например, Основная карта"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="30" />

                <TextView
                    style="@style/Jp.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="4dp"
                    android:text="Только название. Номер карты вводить не нужно." />
            </LinearLayout>

            <TextView
                android:id="@+id/preview"
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/d_box_s2"
                android:lineSpacingMultiplier="1.15"
                android:padding="16dp"
                android:textColor="?attr/jpTx2"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_save"
                style="@style/Jp.Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="24dp"
                android:text="Добавить подписку" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
