<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/d_sheet"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/d_handle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/Jp.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Аватар"
                android:textSize="20sp" />

            <ru.eridian.justpay.ui.AvatarView
                android:id="@+id/av_preview"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/av_caption"
                style="@style/Jp.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Цвет" />

            <LinearLayout
                android:id="@+id/av_colors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Знак" />

            <ru.eridian.justpay.ui.FlowLayout
                android:id="@+id/av_symbols"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:id="@+id/av_photo_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/av_photo_change"
                    style="@style/Jp.Btn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="16dp"
                    android:text="Другое фото"
                    android:textColor="?attr/jpAct" />

                <TextView
                    android:id="@+id/av_photo_delete"
                    style="@style/Jp.Btn.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Удалить фото"
                    android:textColor="@color/jp_err" />
            </LinearLayout>

            <TextView
                style="@style/Jp.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.15"
                android:text="Фото выбирается в системном окне, обрезается до квадрата и хранится только на этом телефоне. Не используйте чужие фотографии без согласия людей на них." />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/av_cancel"
            style="@style/Jp.Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отмена" />

        <TextView
            android:id="@+id/av_save"
            style="@style/Jp.Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:minHeight="54dp"
            android:text="Сохранить"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
