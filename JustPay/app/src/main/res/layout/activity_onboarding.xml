<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/jpBg"
    android:orientation="vertical">

    <!-- Кнопка «Пропустить» -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/ob_skip"
            style="@style/Jp.Btn.Text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Пропустить" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <!-- Страница 1: орбита -->
                <FrameLayout
                    android:id="@+id/ob_page0"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center">

                    <View
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:background="@drawable/d_ring" />

                    <View
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:background="@drawable/d_ring" />

                    <View
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:background="@drawable/d_oval_s1" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="30dp"
                        android:layout_marginEnd="52dp"
                        android:background="@drawable/d_dot"
                        android:backgroundTint="?attr/jpTx3" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="22dp"
                        android:layout_marginBottom="62dp"
                        android:background="@drawable/d_dot"
                        android:backgroundTint="?attr/jpTx3" />

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_logo_hero" />
                </FrameLayout>

                <!-- Страница 2: сумма и ближайшие списания -->
                <LinearLayout
                    android:id="@+id/ob_page1"
                    style="@style/Jp.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="22dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/Jp.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В месяц" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ob_total"
                            style="@style/Jp.Disp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.03"
                            android:maxLines="1"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/ob_cur"
                            style="@style/Jp.Disp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="₽"
                            android:textColor="?attr/jpTx3"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ob_mini"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Страница 3: пауза и экономия -->
                <LinearLayout
                    android:id="@+id/ob_page2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/Jp.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            style="@style/Jp.Disp"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/d_tile"
                            android:gravity="center"
                            android:text="Иви"
                            android:textSize="12sp" />

                        <TextView
                            style="@style/Jp.Bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="Иви"
                            android:textSize="16sp" />

                        <TextView
                            style="@style/Jp.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/d_seg_bar_bg"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:text="На паузе"
                            android:textColor="?attr/jpAct"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/d_next_card"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            style="@style/Jp.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.72"
                            android:text="Экономия за год"
                            android:textColor="@color/jp_ink"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/ob_saved"
                            style="@style/Jp.Disp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="-0.02"
                            android:text="+4 788 ₽"
                            android:textColor="@color/jp_ink"
                            android:textSize="36sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="28dp">

                <TextView
                    android:id="@+id/ob_title"
                    style="@style/Jp.Disp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.1"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/ob_body"
                    style="@style/Jp.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="?attr/jpTx2"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Индикаторы точек и кнопка «Далее» -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/ob_dots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/ob_next"
            style="@style/Jp.Btn.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingEnd="28dp" />
    </LinearLayout>
</LinearLayout>
