<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/d_box_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        style="@style/Jp.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вы сэкономите" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/b_month"
            style="@style/Jp.Disp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="?attr/jpAct"
            android:textSize="34sp" />

        <TextView
            style="@style/Jp.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="в месяц"
            android:textColor="?attr/jpTx2"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/b_year"
        style="@style/Jp.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp" />

    <View
        style="@style/Jp.DividerLine"
        android:layout_marginTop="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Jp.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Расходы в месяц"
            android:textColor="?attr/jpTx2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/b_before"
            style="@style/Jp.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/jpTx3"
            android:textSize="14sp" />

        <TextView
            style="@style/Jp.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="→"
            android:textColor="?attr/jpTx2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/b_after"
            style="@style/Jp.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
