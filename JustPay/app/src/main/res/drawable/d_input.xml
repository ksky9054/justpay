<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/jpS1" />
            <stroke android:width="1.5dp" android:color="@color/jp_err" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/jpS1" />
            <stroke android:width="1.5dp" android:color="?attr/jpTx3" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/jpS1" />
            <stroke android:width="1.5dp" android:color="?attr/jpLine" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
