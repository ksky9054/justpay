<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/jpBg"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btn_back"
                style="@style/Jp.CircleBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Назад"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_edit"
                style="@style/Jp.Btn.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Изменить"
                android:textColor="?attr/jpAct" />

            <TextView
                android:id="@+id/pill_status"
                style="@style/Jp.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/d_mk"
                style="@style/Jp.Disp"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/d_card"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/d_name"
                style="@style/Jp.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/d_cat"
                style="@style/Jp.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="?attr/jpTx2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/d_price"
                    style="@style/Jp.Disp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.03"
                    android:maxLines="1"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/d_cyc"
                    style="@style/Jp.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="?attr/jpTx3"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Сетка 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/Jp.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Следующее списание" android:textSize="12sp" />
                    <TextView android:id="@+id/d_next" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                    <TextView android:id="@+id/d_rel" style="@style/Jp.Semi" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textColor="?attr/jpAct" android:textSize="12sp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/jpLine" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/Jp.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Период" android:textSize="12sp" />
                    <TextView android:id="@+id/d_cycle" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/Jp.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Карта" android:textSize="12sp" />
                    <TextView android:id="@+id/d_card" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/jpLine" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView style="@style/Jp.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="В год" android:textSize="12sp" />
                    <TextView android:id="@+id/d_year" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/jpLine" />

            <LinearLayout
                android:id="@+id/d_remind_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/d_row"
                android:clickable="true"
                android:contentDescription="Изменить напоминание"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Jp.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Напоминание об оплате" android:textSize="12sp" />
                    <TextView android:id="@+id/d_remind" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                    <TextView android:id="@+id/d_remind_sub" style="@style/Jp.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                </LinearLayout>

                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="12dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

        <!-- Использование и серия -->
        <TextView
            style="@style/Jp.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="Использование"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/u_star"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/u_streak"
                            style="@style/Jp.Disp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="-0.02"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/u_streak_label"
                            style="@style/Jp.Semi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="?attr/jpTx2"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/u_best"
                        style="@style/Jp.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/u_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/d_box_bg"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">
                    <TextView style="@style/Jp.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Раз за 30 дней" />
                    <TextView android:id="@+id/u_uses" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Jp.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Время в приложении" />
                    <TextView android:id="@+id/u_time" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Jp.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Цена за раз" />
                    <TextView android:id="@+id/u_cost" style="@style/Jp.Bold" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/u_hint"
                style="@style/Jp.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="?attr/jpTx2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/u_mark"
                style="@style/Jp.Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="52dp"
                android:text="Пользовался сегодня"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/u_unmark"
                style="@style/Jp.Btn.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Убрать отметку за сегодня" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="?attr/jpLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView style="@style/Jp.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Откуда данные" android:textSize="12sp" />
                <TextView android:id="@+id/u_source" style="@style/Jp.Semi" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="14sp" />
                <TextView android:id="@+id/u_source_hint" style="@style/Jp.Caption" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:lineSpacingMultiplier="1.15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/u_link"
                    style="@style/Jp.Btn.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/u_unlink"
                    style="@style/Jp.Btn.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="Отвязать"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Jp.Bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:text="История списаний"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/d_hist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/d_card"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/btn_toggle"
                style="@style/Jp.Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/btn_delete"
                style="@style/Jp.Btn.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Удалить из JustPay" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
