<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/jpBg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Jp.Disp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="-0.01"
                android:text="JustPay"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/auth_title"
            style="@style/Jp.Disp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingMultiplier="1.1"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/auth_subtitle"
            style="@style/Jp.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="?attr/jpTx2"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/d_seg_bar"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_login"
                style="@style/Jp.Seg"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Вход" />

            <TextView
                android:id="@+id/tab_register"
                style="@style/Jp.Seg"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Регистрация" />
        </LinearLayout>

        <!-- Имя (только при регистрации) -->
        <LinearLayout
            android:id="@+id/block_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="4dp"
                android:text="Как к вам обращаться" />

            <EditText
                android:id="@+id/a_name"
                style="@style/Jp.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Имя"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="30" />

            <TextView
                android:id="@+id/err_name"
                style="@style/Jp.FieldError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            style="@style/Jp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="4dp"
            android:text="Электронная почта" />

        <EditText
            android:id="@+id/a_email"
            style="@style/Jp.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="name@example.com"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:maxLength="60" />

        <TextView
            android:id="@+id/err_email"
            style="@style/Jp.FieldError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/Jp.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="4dp"
            android:text="Пароль" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/a_pass"
                style="@style/Jp.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Не короче 6 символов"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLength="64"
                android:paddingEnd="84dp" />

            <TextView
                android:id="@+id/btn_show"
                style="@style/Jp.Btn.Text"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_gravity="end"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="Показать"
                android:textColor="?attr/jpAct" />
        </FrameLayout>

        <TextView
            android:id="@+id/err_pass"
            style="@style/Jp.FieldError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Повтор пароля (только при регистрации) -->
        <LinearLayout
            android:id="@+id/block_pass2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Jp.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="4dp"
                android:text="Повторите пароль" />

            <EditText
                android:id="@+id/a_pass2"
                style="@style/Jp.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLength="64" />

            <TextView
                android:id="@+id/err_pass2"
                style="@style/Jp.FieldError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/auth_error"
            style="@style/Jp.FieldError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/auth_submit"
            style="@style/Jp.Btn.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <TextView
            style="@style/Jp.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Аккаунт хранится только на этом телефоне и никуда не отправляется. Пароль в базе лежит в виде хеша, поэтому восстановить его нельзя. Почта не проверяется." />
    </LinearLayout>
</ScrollView>
