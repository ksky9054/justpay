<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/d_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/d_handle" />

    <TextView
        style="@style/Jp.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Свой срок напоминания"
        android:textSize="20sp" />

    <TextView
        style="@style/Jp.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.15"
        android:text="За сколько дней до списания присылать уведомление. Так будет у всех подписок, у которых не задана своя дата."
        android:textColor="?attr/jpTx2"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/d_box_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/dy_minus"
            style="@style/Jp.CircleBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/d_circle_btn_s2"
            android:contentDescription="Меньше"
            android:scaleType="center"
            android:src="@drawable/ic_minus" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dy_value"
                style="@style/Jp.Disp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/dy_unit"
                style="@style/Jp.Semi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/jpTx2"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/dy_plus"
            style="@style/Jp.CircleBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/d_circle_btn_s2"
            android:contentDescription="Больше"
            android:scaleType="center"
            android:src="@drawable/ic_plus_tx" />
    </LinearLayout>

    <TextView
        android:id="@+id/dy_example"
        style="@style/Jp.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dy_cancel"
            style="@style/Jp.Btn.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отмена" />

        <TextView
            android:id="@+id/dy_save"
            style="@style/Jp.Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:minHeight="54dp"
            android:text="Сохранить"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
